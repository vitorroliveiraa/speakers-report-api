{
  "name": "speakers-report-api",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "npm run clean && tsup src && npm run migrate:latest && npm run knex:seed",
    "clean": "rm -rf dist",
    "knex": "tsx -r sucrase/register ./node_modules/knex/bin/cli.js",
    "migrate:make": "npm run knex -- migrate:make $1 --knexfile ./src/database/knexfile.ts",
    "migrate:latest": "npm run knex -- migrate:latest --knexfile ./src/database/knexfile.ts",
    "migrate:rollback:all": "npm run knex -- migrate:rollback --all --knexfile ./src/database/knexfile.ts",
    "seed:make": "npm run knex -- seed:make $1 --knexfile ./src/database/knexfile.ts",
    "knex:seed": "npm run knex -- seed:run --knexfile ./src/database/knexfile.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "exports": "./dist/index.mjs",
  "dependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.4",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.10",
    "sucrase": "^3.35.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
